      "Category": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "evidence": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Visible numeric label, verbatim; null if unclear",
            "title": "Evidence"
          }
        },
        "required": [
          "label",
          "value",
          "evidence"
        ],
        "title": "Category",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "supported": {
