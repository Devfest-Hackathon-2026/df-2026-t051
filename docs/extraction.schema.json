{
  "$defs": {
    "Category": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "evidence": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Visible numeric label, verbatim; null if unclear",
          "title": "Evidence"
        }
      },
      "required": [
        "label",
        "value",
        "evidence"
      ],
      "title": "Category",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "supported": {
      "title": "Supported",
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 400,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Title"
    },
    "unit": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unit"
    },
    "categories": {
      "items": {
        "$ref": "#/$defs/Category"
      },
      "maxItems": 12,
      "title": "Categories",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "supported",
    "reason",
    "title",
    "unit",
    "categories",
    "warnings"
  ],
  "title": "Extraction",
  "type": "object"
}